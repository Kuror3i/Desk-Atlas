{
  "name": "deskatlas-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:admin": "pnpm --filter @deskatlas/admin-portal dev",
    "dev:customer": "pnpm --filter @deskatlas/customer-website dev",
    "dev:kiosk": "pnpm --filter @deskatlas/kiosk dev",
    "start:api": "pnpm --filter @deskatlas/api --filter @deskatlas/api start",
    "db:migrate": "node scripts/run-migrations.js",
    "db:seed": "node scripts/run-migrations.js",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "mocha": "^11.8.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.35.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.23.0"
  }
}
