{
  "name": "deskatlas-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:admin": "pnpm --filter @deskatlas/admin-portal dev",
    "dev:customer": "pnpm --filter @deskatlas/customer-website dev",
    "dev:kiosk": "pnpm --filter @deskatlas/kiosk dev",
    "dev:staff": "pnpm --filter @deskatlas/staff-dashboard dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "mocha": "^11.8.0",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3"
  }
}
