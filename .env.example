# Copy to .env or set these in your environment
# For front-end apps (Vite) use VITE_ prefix so values are exposed to the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# For server-side scripts or admin operations use a service role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional single DATABASE_URL for psql migration/seed convenience
DATABASE_URL=postgresql://user:password@localhost:5432/deskatlas
VITE_API_URL=http://localhost:3001
# Allow using the `x-dev-auth-uid` header to emulate an authenticated user in development
ALLOW_DEV_AUTH_HEADER=true
