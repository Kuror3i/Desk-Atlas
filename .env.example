# DeskAtlas Admin backend connection.
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it to browser code.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend Transactional Email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL="DeskAtlas <bookings@your-verified-domain.com>"
TRANSACTIONAL_EMAIL_WEBHOOK_URL=
